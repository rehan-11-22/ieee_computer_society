# Local MongoDB: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ieee_certificate_portal

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public application origin used inside clickable links in generated PDFs
# NEXT_PUBLIC_SITE_URL=https://certificates.example.org

# Optional values used by `npm run seed`
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=choose-a-strong-password

# Only needed temporarily by `npm run migrate:supabase`
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
